KB_SOURCE_DIR=/srv/knowledge
KB_NAME=folder-knowledge
# Set a random token of at least 24 characters; never commit the real value.
KB_ADMIN_TOKEN=
# For HTTPS reverse proxy, list its real Host header too.
KB_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,kb.example.internal,kb.example.internal:*
# Default binds only the host loopback. Use the server's intranet IP if accessing directly.
KB_BIND_IP=127.0.0.1
KB_PORT=8790
