{
  "id": "simple-rag-python",
  "version": "1.0.0",
  "protocol_version": "1.1",
  "name": "简易 RAG · 程序插件",
  "maintainer": "Folder KB",
  "description": "由独立程序负责 Markdown 分块、SQLite FTS5 索引、BM25 查询与目录过滤。",
  "capabilities": [],
  "entrypoints": {},
  "runtime": {"type": "trusted-python-demo", "timeout_seconds": 60},
  "output": {"directory": "workspace", "required_files": []},
  "config_schema": {"type": "object", "additionalProperties": false},
  "plugin": {
    "manifest_version": "1.0",
    "instructions": "用 search 查找证据，已知目录时通过 path 缩小范围。需要上下文时读取来源文件。检索无命中不代表资料一定不存在。",
    "indexing": {
      "mode": "fulltext",
      "splitter": "custom",
      "entrypoint": ["python", "search.py"],
      "search_protocol": "1.0",
      "supports_path_filter": true,
      "include": ["**/*.md", "**/*.txt"],
      "exclude": ["drafts/**", "archive/**"]
    }
  }
}
